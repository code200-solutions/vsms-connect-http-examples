{
  "name": "vsms-connect-http-client",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Zero-dependency integration examples + E2E test suite for the VSMS Connect generic HTTP connector",
  "engines": {
    "node": ">=20.6"
  },
  "scripts": {
    "test": "node --env-file=.env --test \"tests/*.test.mjs\"",
    "case": "node examples/run.mjs",
    "format": "prettier --write \"examples/**/*.{mjs,md}\" \"tests/**/*.mjs\" \"docs/**/*.md\" \"*.md\" \"*.json\""
  },
  "devDependencies": {
    "prettier": "^3.3.0"
  }
}
