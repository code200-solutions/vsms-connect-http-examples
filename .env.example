# Backend URL up to and including /api/v1 (agent convention)
VSMS_CONNECT_BACKEND_URL=http://localhost:3000/api/v1

# Business ID (UUID) — visible in the app after registering a business
VSMS_CONNECT_BUSINESS_ID=YOUR_BUSINESS_ID_HERE

# API key with scope "http" — created in the app's API Keys screen (plaintext shown once)
VSMS_CONNECT_API_KEY=YOUR_API_KEY_HERE

# There is deliberately NO location variable here. Multi-location routing is
# driven by YOUR OWN store code: declare your codes (POST /businesses/:id/stores)
# and send `storeCode` on the fiscalise body. The examples and the test suite
# carry `STORE-PV-01` as a literal fixture — a selector injected from the
# environment would be invisible to anyone reading the request body, which is
# the whole point of these files. See examples/17-multi-location.mjs.
#
# That code has to be mapped to one of your business locations once (Generic HTTP
# screen → Stores tab) or every fresh sale blocks with HTTP_STORE_NOT_MAPPED.

# Optional (examples/invoice-basis/ only): a SECOND business, registered on
# INVOICE basis, plus its own scope-"http" API key.
#
# VAT accounting basis is a property of the business, fixed when it is
# REGISTERED and not editable afterwards — it is not a field you can put on a
# request. So the two example sets need two businesses: everything in
# examples/01-27 runs against the cash-basis one above, and examples/invoice-basis/
# runs against this one. Leave both unset and the invoice-basis scripts fall back
# to the credentials above, which is right if that business is already on invoice
# basis (they detect the mismatch and say so if it is not).
# VSMS_CONNECT_IB_BUSINESS_ID=YOUR_INVOICE_BASIS_BUSINESS_ID_HERE
# VSMS_CONNECT_IB_API_KEY=YOUR_INVOICE_BASIS_API_KEY_HERE

# Optional (test suite only): client-side fetch timeout in ms (default 60000).
# Raise it when the backend is slow to respond (tunnelled/remote stacks).
# VSMS_CONNECT_HTTP_TIMEOUT_MS=60000
